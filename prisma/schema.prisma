generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id                  String             @id @default(uuid())
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  userName            String             @db.VarChar(255)
  profileIcon         String             @default("")
  xUrl                String             @default("")
  instagramUrl        String             @default("")
  threadsUrl          String             @default("")
  githubUrl           String             @default("")
  email               String             @db.VarChar(255)
  password_hash       String             @db.VarChar(255)
  errorLog            ErrorLog[]
}

enum ResolutionStatus {
  RESOLVED   
  UNRESOLVED
}


model ErrorLog {
  id                     String            @id @default(uuid())
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  title                  String            @db.VarChar(255)
  status                 ResolutionStatus  @default(UNRESOLVED)          
  os                     String            @db.VarChar(255)
  framework_version      String            @db.VarChar(255)
  framework              String            @db.VarChar(255)
  solution               String?           @db.Text
  cause                  String            @db.Text
  error_message          String            @db.Text
  userId                 String            
  user                   User             @relation(fields: [userId], references: [id])
  errorLogTag            ErrorLogTag[]
}

model Tag {
  id                     String            @id @default(uuid())           
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  tag_name               String            @db.VarChar(100)
  errorLogTag            ErrorLogTag[]     
}

model ErrorLogTag {
  id                     String           @id @default(uuid())
  errorLogId             String           
  tagId                  String                  
  errorlog               ErrorLog         @relation(fields: [errorLogId], references: [id])
  tag                    Tag              @relation(fields: [tagId], references: [id])

  @@unique([errorLogId, tagId])
}